{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiseki.dev/schemas/manifest.v1.schema.json",
  "title": "Kiseki Theme Manifest v1",
  "description": "Package metadata, appearance mode, declared layers, and asset provenance for a Kiseki v2 theme pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "appearance",
    "authors",
    "license",
    "creditsFile",
    "layers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 256
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$",
      "description": "Unique lowercase kebab-case theme identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\r\\n\\t\\u0000-\\u001F]+$"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\r\\n\\t\\u0000-\\u001F]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "appearance": {
      "type": "string",
      "enum": ["dark", "light"]
    },
    "pairedTheme": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{1,47}$",
      "description": "Optional companion theme ID for opposite light/dark appearance."
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\r\\n\\u0000-\\u001F]+$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 256
          }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9.+-]+(?: (?:AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
      "description": "SPDX license expression for theme definitions and original assets."
    },
    "creditsFile": {
      "$ref": "#/$defs/safeRelativePath"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "palette" },
      "items": {
        "type": "string",
        "enum": ["palette", "syntax", "ui", "atmosphere", "typography", "overrides"]
      }
    },
    "minEngineVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "preview": {
      "$ref": "#/$defs/safeRelativePath"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Asset origin declarations for automated Gallery auditing.",
      "properties": {
        "wallpaperOrigin": {
          "type": "string",
          "enum": ["original", "cc0", "cc-by", "licensed", "none"]
        },
        "shaderOrigin": {
          "type": "string",
          "enum": ["original", "mit-adapted", "none"]
        },
        "sourceRepo": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 256
        }
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"
    }
  }
}
