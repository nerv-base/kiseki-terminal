{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "UNIT-02 // {{ .Folder }}",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#6F6462",
    "template": "▸ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#FFF3E6",
          "background": "#D8262E",
          "template": "<#D8262E,transparent>▛</> <b>02</b> <#D8262E,transparent>▟</>"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#ECE4DA",
          "background": "#171214",
          "template": "<#0B090A,transparent> </><#F06A22>┃</> \ue5ff <b>{{ .Path }}</b> ",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "home_icon": "~",
            "max_depth": 2
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FFC08F",
          "background": "#221215",
          "template": "<#0B090A,transparent> </><#D8262E>┃</> \ue725 {{ .HEAD }}{{ if .BranchStatus }} <#62C6F2>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} <#F5C96A>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#3FE08A>\uf046 {{ .Staging.String }}</>{{ end }} ",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#3FE08A",
          "background": "#0E1D16",
          "template": "<#0B090A,transparent> </><#3FE08A>┃</> \ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#3FE08A",
          "background": "#0E1D16",
          "template": "<#0B090A,transparent> </><#3FE08A>┃</> \ue718 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#FF8A3D",
          "background": "#23140E",
          "template": "<#0B090A,transparent> </><#F06A22>┃</> \ue7a8 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#62C6F2",
          "background": "#101B22",
          "template": "<#0B090A,transparent> </><#62C6F2>┃</> \ue627 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#F5C96A",
          "background": "#241910",
          "template": "<#F0B53A>┃ \uf0e7 {{ .FormattedMs }} </>",
          "properties": {
            "threshold": 1500,
            "style": "roundrock"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#DDD3C9",
          "background": "#171214",
          "template": "<#0B090A,transparent> </><#F06A22>┃</> <#3FE08A>SYNC 99.2%</> <#6F6462>·</> {{ .CurrentDate | date .Format }} <#D8262E,transparent>▜</>",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#F06A22",
          "background": "transparent",
          "template": "<#55383B>┗━</>{{ if gt .Code 0 }}<#F0413C>[精神汚染 // ERR:{{ .Code }}] ▸</>{{ else }}<#D8262E>[弐号機]</> <#F06A22>▸</>{{ end }}",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
