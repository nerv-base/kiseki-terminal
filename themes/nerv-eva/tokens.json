{
  "$schema": "../../schemas/tokens.v1.schema.json",
  "schemaVersion": 1,
  "palette": {
    "surfaces": {
      "crust": "#070506",
      "mantle": "#0E0B0C",
      "base": "#0B090A",
      "surface0": "#171214",
      "surface1": "#241418",
      "surface2": "#55383B",
      "overlay0": "#6F6462",
      "overlay1": "#A59A93"
    },
    "text": {
      "primary": "#ECE4DA",
      "secondary": "#DDD3C9",
      "muted": "#8C7D78",
      "inverse": "#0B090A"
    },
    "accents": {
      "primary": "#F06A22",
      "secondary": "#D8262E",
      "tertiary": "#62C6F2"
    },
    "semantic": {
      "error": "#F0413C",
      "warning": "#F5C96A",
      "success": "#3FE08A",
      "info": "#62C6F2",
      "hint": "#FF8A3D"
    },
    "interaction": {
      "cursor": "#F06A22",
      "cursorText": "#0B090A",
      "selectionBg": "#4E1218",
      "selectionFg": "#FFF7F2",
      "matchBg": "#4A2410",
      "matchFg": "#FFC08F"
    },
    "ansi": {
      "black": "#171214",
      "red": "#D8262E",
      "green": "#3FE08A",
      "yellow": "#F06A22",
      "blue": "#62C6F2",
      "magenta": "#E05A6D",
      "cyan": "#FF8A3D",
      "white": "#DDD3C9",
      "brightBlack": "#7D706B",
      "brightRed": "#F0413C",
      "brightGreen": "#86F7BB",
      "brightYellow": "#F5C96A",
      "brightBlue": "#8FD8FA",
      "brightMagenta": "#FFA58F",
      "brightCyan": "#FFC08F",
      "brightWhite": "#FFF7F2"
    }
  },
  "syntax": {
    "keyword": "#FF5A52",
    "operator": "#F06A22",
    "function": "#FFC08F",
    "method": "#FFC08F",
    "type": "#F0B53A",
    "variable": "#ECE4DA",
    "parameter": "#F5C96A",
    "property": "#62C6F2",
    "string": "#7FDCA4",
    "escape": "#86F7BB",
    "number": "#FF9A52",
    "boolean": "#FF9A52",
    "constant": "#FFA58F",
    "comment": "#8C7D78",
    "punctuation": "#A59A93",
    "tag": "#D8262E",
    "attribute": "#F5C96A",
    "macro": "#FF8A3D",
    "invalid": "#F0413C"
  },
  "ui": {
    "windowFrame": "#55383B",
    "windowFrameUnfocused": "#24191B",
    "tabBarBg": "#070506",
    "tabBarUnfocusedBg": "#050405",
    "tabActiveBg": "#171214",
    "tabActiveFg": "#FFF7F2",
    "tabInactiveBg": "#0E0B0C",
    "tabInactiveFg": "#7D706B",
    "statuslineBg": "#171214",
    "statuslineFg": "#ECE4DA",
    "border": "#55383B",
    "borderFocused": "#F06A22",
    "panelBg": "#120D0E"
  },
  "atmosphere": {
    "window": {
      "opacity": 0.95,
      "unfocusedOpacity": 0.88,
      "blur": true,
      "blurRadius": 20,
      "useMica": false,
      "padding": { "x": 18, "y": 14 }
    },
    "wallpaper": {
      "path": "assets/wallpaper.png",
      "opacity": 0.78,
      "unfocusedOpacity": 0.45,
      "alignment": "bottom-right",
      "fit": "cover",
      "codeSafeZone": { "side": "left", "startX": 0.0, "endX": 0.56 }
    },
    "shader": {
      "glsl": "shaders/live.glsl",
      "hlsl": "shaders/live.hlsl",
      "defaultProfile": "balanced",
      "params": {
        "scanPeriodSec": 7.5,
        "glitchIntervalSec": 6.0,
        "narrowFadeAspect": 1.15,
        "heartbeatHz": 1.9,
        "hexCellPx": 46.0
      }
    }
  },
  "typography": {
    "style": "modern",
    "families": ["jetbrains-mono-nf", "maple-mono-nf-cn"],
    "sizePt": 11.0,
    "lineHeight": 1.26,
    "weight": "normal",
    "ligatures": true
  },
  "overrides": {
    "terminal": {
      "cursorShape": "block",
      "cursorBlink": false,
      "macosTitlebarStyle": "transparent"
    },
    "prompt": {
      "preset": "tactical-bar",
      "badgeText": "02",
      "okLabel": "[弐号機]",
      "errorLabel": "[精神汚染]",
      "promptSymbol": "▸",
      "consoleTitlePrefix": "UNIT-02",
      "segmentColors": {
        "badgeBg": "#D8262E",
        "badgeFg": "#FFF3E6",
        "pathBg": "#171214",
        "pathFg": "#ECE4DA",
        "gitBg": "#221215",
        "gitFg": "#FFC08F"
      }
    },
    "fzf": {
      "border": "sharp",
      "prompt": "02▸ ",
      "pointer": "▸",
      "marker": "■"
    },
    "fastfetch": {
      "logoPath": "assets/logo.txt",
      "headerTitle": "EVANGELION UNIT-02 // 弐号機",
      "fieldLabels": {
        "title": "PILOT",
        "os": "SYS",
        "shell": "SHELL",
        "terminal": "PLUG",
        "cpu": "MAGI",
        "memory": "LCL",
        "uptime": "POWER"
      }
    }
  }
}
