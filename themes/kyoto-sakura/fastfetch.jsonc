{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/kiseki-terminal/themes/kyoto-sakura/logo.txt",
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;255;158;199m「 \u001b[1;38;2;255;235;244m✿ 夜樱绘卷 // KYOTO SAKURA \u001b[0;38;2;255;158;199m」\u001b[0m" },
    { "type": "title", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;255;158;199m❀ 宿主 ", "format": "\u001b[1;38;2;255;235;244m{user-name}\u001b[38;2;255;201;113m@\u001b[38;2;196;167;255m{host-name}\u001b[0m" },
    { "type": "os", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;255;201;113m❀ 系统 ", "format": "\u001b[38;2;240;222;234m{pretty-name}\u001b[0m" },
    { "type": "shell", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;134;227;206m❀ 终端 ", "format": "\u001b[38;2;240;222;234m{pretty-name} {version}\u001b[0m" },
    { "type": "terminal", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;196;167;255m❀ 视窗 ", "format": "\u001b[38;2;240;222;234m{pretty-name}\u001b[0m" },
    { "type": "cpu", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;255;107;123m❀ 核心 ", "format": "\u001b[38;2;240;222;234m{name} ({cores-logical}T)\u001b[0m" },
    { "type": "memory", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;255;158;199m❀ 内存 ", "format": "\u001b[38;2;240;222;234m{used} / {total} ({percentage})\u001b[0m" },
    { "type": "uptime", "key": "\u001b[38;2;115;92;130m│ \u001b[38;2;255;201;113m❀ 运行 ", "format": "\u001b[38;2;240;222;234m{days}d {hours}h {minutes}m\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;115;92;130m╰─ \u001b[38;2;255;107;123m✿ \u001b[38;2;255;158;199m✿ \u001b[38;2;255;201;113m✿ \u001b[38;2;134;227;206m✿ \u001b[38;2;148;180;255m✿ \u001b[38;2;196;167;255m✿ \u001b[38;2;255;235;244m✿ \u001b[38;2;115;92;130m────────────────────────\u001b[0m" }
  ]
}
