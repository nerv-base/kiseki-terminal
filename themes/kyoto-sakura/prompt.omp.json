{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "✿ {{ .Folder }} · 夜樱",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#735C82",
    "template": "› "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#FFEBF4",
          "background": "#23152E",
          "template": "<#FF9EC7,transparent>「</><#FF9EC7> ✿</> <b>{{ .Path }}</b> <#FF9EC7,transparent>」</>",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "home_icon": "~",
            "max_depth": 2
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#C4A7FF",
          "background": "#1E142B",
          "template": "<#130D1B,transparent> </> <#FFC971>·</> \ue725 {{ .HEAD }}{{ if .BranchStatus }} <#86E3CE>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} <#FFC971>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#86E3CE>\uf046 {{ .Staging.String }}</>{{ end }} ",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#86E3CE",
          "background": "#1A162B",
          "template": "<#130D1B,transparent> </> \ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#86E3CE",
          "background": "#1A162B",
          "template": "<#130D1B,transparent> </> \ue718 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#FFC971",
          "background": "#241626",
          "template": "<#130D1B,transparent> </> \ue7a8 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#86E3CE",
          "background": "#1A162B",
          "template": "<#130D1B,transparent> </> \ue627 {{ .Major }}.{{ .Minor }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#FFC971",
          "background": "#251728",
          "template": " \uf0e7 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 1500,
            "style": "roundrock"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#F0D5E6",
          "background": "#1D1329",
          "template": "<#130D1B,transparent> </><#FFC971,transparent>「</> {{ .CurrentDate | date .Format }} <#FFC971,transparent>」</>",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FF9EC7",
          "background": "transparent",
          "template": "  {{ if gt .Code 0 }}<#FF6B7B>「\uf00d {{ .Code }}」 ›</>{{ else }}<#FFC971>❀</> <#FF9EC7>›</>{{ end }}",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
