{
  "$schema": "../../schemas/tokens.v1.schema.json",
  "schemaVersion": 1,
  "palette": {
    "surfaces": {
      "crust": "#0A0712",
      "mantle": "#120C1C",
      "base": "#0F0B19",
      "surface0": "#1C142B",
      "surface1": "#281938",
      "surface2": "#4F2B4C",
      "overlay0": "#634873",
      "overlay1": "#A88FB8"
    },
    "text": {
      "primary": "#F7EBF4",
      "secondary": "#EADAE6",
      "muted": "#8B739C",
      "inverse": "#0F0B19"
    },
    "accents": {
      "primary": "#FF9EC7",
      "secondary": "#FFC971",
      "tertiary": "#C4A7FF"
    },
    "semantic": {
      "error": "#FF6B7B",
      "warning": "#FFC971",
      "success": "#86E3CE",
      "info": "#94B4FF",
      "hint": "#C4A7FF"
    },
    "interaction": {
      "cursor": "#FF9EC7",
      "cursorText": "#0F0B19",
      "selectionBg": "#3B2447",
      "selectionFg": "#FFF7FC",
      "matchBg": "#4A2342",
      "matchFg": "#FFE0A3"
    },
    "ansi": {
      "black": "#1C142B",
      "red": "#FF6B7B",
      "green": "#86E3CE",
      "yellow": "#FFC971",
      "blue": "#94B4FF",
      "magenta": "#C4A7FF",
      "cyan": "#8BE8E5",
      "white": "#EADAE6",
      "brightBlack": "#826A94",
      "brightRed": "#FF9EC7",
      "brightGreen": "#ACF0DF",
      "brightYellow": "#FFE0A3",
      "brightBlue": "#B5CCFF",
      "brightMagenta": "#DFC9FF",
      "brightCyan": "#B5F5F2",
      "brightWhite": "#FFF7FC"
    }
  },
  "syntax": {
    "keyword": "#FF6B7B",
    "operator": "#FF6B7B",
    "function": "#FF9EC7",
    "method": "#FF9EC7",
    "type": "#8BE8E5",
    "variable": "#F7EBF4",
    "parameter": "#C4A7FF",
    "property": "#94B4FF",
    "string": "#86E3CE",
    "escape": "#ACF0DF",
    "number": "#FFC971",
    "boolean": "#FFC971",
    "constant": "#FFE0A3",
    "comment": "#8B739C",
    "punctuation": "#A88FB8",
    "tag": "#FF9EC7",
    "attribute": "#FFC971",
    "macro": "#DFC9FF",
    "invalid": "#FF6B7B"
  },
  "ui": {
    "windowFrame": "#4F2B4C",
    "windowFrameUnfocused": "#1C1329",
    "tabBarBg": "#0A0712",
    "tabBarUnfocusedBg": "#08050E",
    "tabActiveBg": "#1E142C",
    "tabActiveFg": "#FFF7FC",
    "tabInactiveBg": "#120C1C",
    "tabInactiveFg": "#8B739C",
    "statuslineBg": "#1C142B",
    "statuslineFg": "#F7EBF4",
    "border": "#634873",
    "borderFocused": "#FF9EC7",
    "panelBg": "#161024"
  },
  "atmosphere": {
    "window": {
      "opacity": 0.94,
      "unfocusedOpacity": 0.86,
      "blur": true,
      "blurRadius": 20,
      "useMica": false,
      "padding": { "x": 20, "y": 14 }
    },
    "wallpaper": {
      "path": "assets/wallpaper.png",
      "opacity": 0.44,
      "unfocusedOpacity": 0.26,
      "alignment": "bottom-right",
      "fit": "cover",
      "codeSafeZone": { "side": "left", "startX": 0.0, "endX": 0.54 }
    },
    "shader": {
      "glsl": "shaders/live.glsl",
      "hlsl": "shaders/live.hlsl",
      "defaultProfile": "balanced",
      "params": {
        "petalSpeed": 1.0,
        "lanternFlickerHz": 2.7,
        "narrowFadeAspect": 1.15,
        "pondRippleAmp": 0.0016
      }
    }
  },
  "typography": {
    "style": "maple",
    "families": ["maple-mono-nf-cn", "jetbrains-mono-nf"],
    "sizePt": 11.0,
    "lineHeight": 1.30,
    "weight": "normal",
    "ligatures": true
  },
  "overrides": {
    "terminal": {
      "cursorShape": "bar",
      "cursorBlink": false,
      "macosTitlebarStyle": "transparent"
    },
    "prompt": {
      "preset": "shrine-ribbon",
      "badgeText": "✿",
      "okLabel": "❀",
      "errorLabel": "散華",
      "promptSymbol": "›",
      "consoleTitlePrefix": "✿ 夜樱",
      "segmentColors": {
        "badgeBg": "#FF9EC7",
        "badgeFg": "#0F0B19",
        "pathBg": "#23152E",
        "pathFg": "#FFEBF4",
        "gitBg": "#1E142B",
        "gitFg": "#C4A7FF"
      }
    },
    "fzf": {
      "border": "rounded",
      "prompt": "❀ ",
      "pointer": "✿",
      "marker": "★"
    },
    "fastfetch": {
      "logoPath": "assets/logo.txt",
      "headerTitle": "✿ 夜樱绘卷 // KYOTO SAKURA",
      "fieldLabels": {
        "title": "❀ 宿主",
        "os": "❀ 系统",
        "shell": "❀ 终端",
        "terminal": "❀ 视窗",
        "cpu": "❀ 核心",
        "memory": "❀ 内存",
        "uptime": "❀ 运行"
      }
    }
  }
}
