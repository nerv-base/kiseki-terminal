{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/kiseki-terminal/themes/shinkai-rain/logo.txt",
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;60;90;106m╭─ \u001b[1;38;2;92;230;208m\uf0e9 言叶之雨 // SHINKAI RAIN \u001b[0;38;2;60;90;106m────────────\u001b[0m" },
    { "type": "title", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;127;184;255m◦ user ", "format": "\u001b[1;38;2;226;242;248m{user-name}\u001b[38;2;92;230;208m@\u001b[38;2;255;203;119m{host-name}\u001b[0m" },
    { "type": "os", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;92;230;208m◦ os   ", "format": "\u001b[38;2;210;230;238m{pretty-name}\u001b[0m" },
    { "type": "shell", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;165;242;158m◦ shell", "format": "\u001b[38;2;210;230;238m{pretty-name} {version}\u001b[0m" },
    { "type": "terminal", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;255;203;119m◦ term ", "format": "\u001b[38;2;210;230;238m{pretty-name}\u001b[0m" },
    { "type": "cpu", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;127;184;255m◦ cpu  ", "format": "\u001b[38;2;210;230;238m{name} ({cores-logical}T)\u001b[0m" },
    { "type": "memory", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;92;230;208m◦ ram  ", "format": "\u001b[38;2;210;230;238m{used} / {total} ({percentage})\u001b[0m" },
    { "type": "uptime", "key": "\u001b[38;2;60;90;106m│ \u001b[38;2;255;140;166m◦ up   ", "format": "\u001b[38;2;210;230;238m{days}d {hours}h {minutes}m\u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;60;90;106m╰─ \u001b[38;2;255;140;166m● \u001b[38;2;255;203;119m● \u001b[38;2;165;242;158m● \u001b[38;2;92;230;208m● \u001b[38;2;127;184;255m● \u001b[38;2;186;156;255m● \u001b[38;2;226;242;248m● \u001b[38;2;60;90;106m─────────────────────────\u001b[0m" }
  ]
}
