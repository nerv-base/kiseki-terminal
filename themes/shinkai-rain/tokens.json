{
  "$schema": "../../schemas/tokens.v1.schema.json",
  "schemaVersion": 1,
  "palette": {
    "surfaces": {
      "crust": "#081018",
      "mantle": "#0B1620",
      "base": "#0C1823",
      "surface0": "#132330",
      "surface1": "#173142",
      "surface2": "#214459",
      "overlay0": "#3C5A6A",
      "overlay1": "#7FA0B2"
    },
    "text": {
      "primary": "#E2F2F8",
      "secondary": "#CFE3EC",
      "muted": "#648596",
      "inverse": "#0C1823"
    },
    "accents": {
      "primary": "#5CE6D0",
      "secondary": "#FFCB77",
      "tertiary": "#7FB8FF"
    },
    "semantic": {
      "error": "#FF7A99",
      "warning": "#FFCB77",
      "success": "#9AE6A0",
      "info": "#7FB8FF",
      "hint": "#BA9CFF"
    },
    "interaction": {
      "cursor": "#5CE6D0",
      "cursorText": "#0C1823",
      "selectionBg": "#1D3B4F",
      "selectionFg": "#F4FBFF",
      "matchBg": "#193A45",
      "matchFg": "#FFE0A3"
    },
    "ansi": {
      "black": "#132330",
      "red": "#FF7A99",
      "green": "#9AE6A0",
      "yellow": "#FFCB77",
      "blue": "#7FB8FF",
      "magenta": "#BA9CFF",
      "cyan": "#5CE6D0",
      "white": "#CFE3EC",
      "brightBlack": "#5E7F91",
      "brightRed": "#FF9EB5",
      "brightGreen": "#B8F5BD",
      "brightYellow": "#FFE0A3",
      "brightBlue": "#A8D0FF",
      "brightMagenta": "#D4C2FF",
      "brightCyan": "#8FF5E5",
      "brightWhite": "#F4FBFF"
    }
  },
  "syntax": {
    "keyword": "#BA9CFF",
    "operator": "#FF8CA6",
    "function": "#5CE6D0",
    "method": "#5CE6D0",
    "type": "#8FF5E5",
    "variable": "#E2F2F8",
    "parameter": "#7FB8FF",
    "property": "#A8D0FF",
    "string": "#9AE6A0",
    "escape": "#B8F5BD",
    "number": "#FFCB77",
    "boolean": "#FFCB77",
    "constant": "#FFE0A3",
    "comment": "#648596",
    "punctuation": "#7FA0B2",
    "tag": "#FF7A99",
    "attribute": "#FFCB77",
    "macro": "#D4C2FF",
    "invalid": "#FF7A99"
  },
  "ui": {
    "windowFrame": "#214459",
    "windowFrameUnfocused": "#10212E",
    "tabBarBg": "#081018",
    "tabBarUnfocusedBg": "#060D14",
    "tabActiveBg": "#132533",
    "tabActiveFg": "#F4FBFF",
    "tabInactiveBg": "#0B1620",
    "tabInactiveFg": "#648596",
    "statuslineBg": "#132330",
    "statuslineFg": "#E2F2F8",
    "border": "#3C5A6A",
    "borderFocused": "#5CE6D0",
    "panelBg": "#0E1D27"
  },
  "atmosphere": {
    "window": {
      "opacity": 0.94,
      "unfocusedOpacity": 0.86,
      "blur": true,
      "blurRadius": 20,
      "useMica": false,
      "padding": { "x": 20, "y": 14 }
    },
    "wallpaper": {
      "path": "assets/wallpaper.jpg",
      "opacity": 0.42,
      "unfocusedOpacity": 0.26,
      "alignment": "bottom-right",
      "fit": "cover",
      "codeSafeZone": { "side": "left", "startX": 0.0, "endX": 0.54 }
    },
    "shader": {
      "glsl": "shaders/live.glsl",
      "hlsl": "shaders/live.hlsl",
      "defaultProfile": "balanced",
      "params": {
        "rainSpeed": 1.0,
        "bokehPulseHz": 1.35,
        "narrowFadeAspect": 1.15,
        "puddleRingRate": 0.55
      }
    }
  },
  "typography": {
    "style": "maple",
    "families": ["maple-mono-nf-cn", "jetbrains-mono-nf"],
    "sizePt": 12.0,
    "lineHeight": 1.30,
    "weight": "normal",
    "ligatures": true
  },
  "overrides": {
    "terminal": {
      "cursorShape": "bar",
      "cursorBlink": false,
      "macosTitlebarStyle": "transparent"
    },
    "prompt": {
      "preset": "cinematic-line",
      "badgeText": "◦",
      "okLabel": "雨夜",
      "errorLabel": "雨断",
      "promptSymbol": "❯",
      "consoleTitlePrefix": "◦ 言叶之雨",
      "segmentColors": {
        "badgeBg": "#5CE6D0",
        "badgeFg": "#0C1823",
        "pathBg": "#0E1D27",
        "pathFg": "#5CE6D0",
        "gitBg": "#0D1C26",
        "gitFg": "#7FB8FF"
      }
    },
    "fzf": {
      "border": "rounded",
      "prompt": "❯ ",
      "pointer": "●",
      "marker": "◆"
    },
    "fastfetch": {
      "logoPath": "assets/logo.txt",
      "headerTitle": "◦ 言叶之雨 // SHINKAI RAIN",
      "fieldLabels": {
        "title": "◦ user",
        "os": "◦ os",
        "shell": "◦ shell",
        "terminal": "◦ term",
        "cpu": "◦ cpu",
        "memory": "◦ ram",
        "uptime": "◦ up"
      }
    }
  }
}
