{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "◦ {{ .Folder }} · 言叶之雨",
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#4F6D7A",
    "template": "› "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#5CE6D0",
          "background": "transparent",
          "template": "<#3C5A6A>╭─</> <#7FB8FF>\uf0e9</> <b>{{ .Path }}</b>",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "home_icon": "~",
            "max_depth": 2
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#7FB8FF",
          "background": "transparent",
          "template": " <#3C5A6A>·</> \ue725 {{ .HEAD }}{{ if .BranchStatus }} <#5CE6D0>{{ .BranchStatus }}</>{{ end }}{{ if .Working.Changed }} <#FFCB77>\uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} <#A5F29E>\uf046 {{ .Staging.String }}</>{{ end }}",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#A5F29E",
          "background": "transparent",
          "template": " <#3C5A6A>·</> \ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Major }}.{{ .Minor }}",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#A5F29E",
          "background": "transparent",
          "template": " <#3C5A6A>·</> \ue718 {{ .Major }}.{{ .Minor }}",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#FFCB77",
          "background": "transparent",
          "template": " <#3C5A6A>·</> \ue7a8 {{ .Major }}.{{ .Minor }}",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "#5CE6D0",
          "background": "transparent",
          "template": " <#3C5A6A>·</> \ue627 {{ .Major }}.{{ .Minor }}",
          "properties": {
            "fetch_version": true,
            "display_mode": "files"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#FFCB77",
          "background": "#0E1D27",
          "template": " \uf0e7 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 1500,
            "style": "roundrock"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#A4C7D8",
          "background": "#0D1C26",
          "template": "<#09141C,transparent> </> <#FFCB77>◦</> {{ .CurrentDate | date .Format }} <#3C5A6A,transparent>─╮</>",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#5CE6D0",
          "background": "transparent",
          "template": "<#3C5A6A>╰─</> {{ if gt .Code 0 }}<#FF8CA6>× {{ .Code }} ❯</>{{ else }}<#5CE6D0>❯</>{{ end }}",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
