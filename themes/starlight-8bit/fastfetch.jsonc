{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/kiseki-terminal/themes/starlight-8bit/logo.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;78;86;138m┌─ \u001b[1;38;2;255;130;184m★ STARLIGHT // 8-BIT TERM \u001b[0;38;2;78;86;138m──────────────\u001b[0m"
    },
    {
      "type": "title",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;255;130;184m♥ USER ",
      "format": "\u001b[1;38;2;232;236;255m{user-name}\u001b[38;2;102;240;255m@\u001b[38;2;180;142;254m{host-name}\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;102;240;255m◈ OS   ",
      "format": "\u001b[38;2;214;220;250m{pretty-name}\u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;114;241;184m▶ SHELL",
      "format": "\u001b[38;2;214;220;250m{pretty-name} {version}\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;255;213;128m▣ TERM ",
      "format": "\u001b[38;2;214;220;250m{pretty-name}\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;180;142;254m✦ CPU  ",
      "format": "\u001b[38;2;214;220;250m{name} ({cores-logical}T)\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;102;240;255m✦ RAM  ",
      "format": "\u001b[38;2;214;220;250m{used} / {total} ({percentage})\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;78;86;138m│ \u001b[38;2;114;241;184m✦ UP   ",
      "format": "\u001b[38;2;214;220;250m{days}d {hours}h {minutes}m\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;78;86;138m└─ \u001b[38;2;255;107;139m██\u001b[38;2;255;143;173m██\u001b[38;2;255;213;128m██\u001b[38;2;114;241;184m██\u001b[38;2;102;240;255m██\u001b[38;2;122;162;247m██\u001b[38;2;180;142;254m██\u001b[38;2;232;236;255m██ \u001b[38;2;78;86;138m───────────────────────\u001b[0m"
    }
  ]
}

