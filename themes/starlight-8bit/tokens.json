{
  "$schema": "../../schemas/tokens.v1.schema.json",
  "schemaVersion": 1,
  "palette": {
    "surfaces": {
      "crust": "#070A18",
      "mantle": "#0A0E22",
      "base": "#0A0F25",
      "surface0": "#151B36",
      "surface1": "#232A54",
      "surface2": "#2B3466",
      "overlay0": "#4E568A",
      "overlay1": "#8F98C9"
    },
    "text": {
      "primary": "#E8ECFF",
      "secondary": "#D6DCFA",
      "muted": "#737DB5",
      "inverse": "#0A0F25"
    },
    "accents": {
      "primary": "#66F0FF",
      "secondary": "#FF82B8",
      "tertiary": "#B48EFE"
    },
    "semantic": {
      "error": "#FF6B8B",
      "warning": "#FFD580",
      "success": "#72F1B8",
      "info": "#7AA2F7",
      "hint": "#B48EFE"
    },
    "interaction": {
      "cursor": "#FF82B8",
      "cursorText": "#0A0F25",
      "selectionBg": "#2B2A5A",
      "selectionFg": "#F8FAFF",
      "matchBg": "#2E2558",
      "matchFg": "#FFE5A3"
    },
    "ansi": {
      "black": "#151B36",
      "red": "#FF6B8B",
      "green": "#72F1B8",
      "yellow": "#FFD580",
      "blue": "#7AA2F7",
      "magenta": "#B48EFE",
      "cyan": "#66F0FF",
      "white": "#D6DCFA",
      "brightBlack": "#6B74A8",
      "brightRed": "#FF8FAD",
      "brightGreen": "#9EFFD3",
      "brightYellow": "#FFE5A3",
      "brightBlue": "#9BB8FF",
      "brightMagenta": "#D2B8FF",
      "brightCyan": "#99F7FF",
      "brightWhite": "#F8FAFF"
    }
  },
  "syntax": {
    "keyword": "#FF6B8B",
    "operator": "#FF82B8",
    "function": "#66F0FF",
    "method": "#66F0FF",
    "type": "#99F7FF",
    "variable": "#E8ECFF",
    "parameter": "#B48EFE",
    "property": "#9BB8FF",
    "string": "#72F1B8",
    "escape": "#9EFFD3",
    "number": "#FFD580",
    "boolean": "#FFD580",
    "constant": "#FFE5A3",
    "comment": "#737DB5",
    "punctuation": "#8F98C9",
    "tag": "#FF82B8",
    "attribute": "#FFD580",
    "macro": "#D2B8FF",
    "invalid": "#FF6B8B"
  },
  "ui": {
    "windowFrame": "#2B3466",
    "windowFrameUnfocused": "#121630",
    "tabBarBg": "#070A18",
    "tabBarUnfocusedBg": "#060814",
    "tabActiveBg": "#131936",
    "tabActiveFg": "#F8FAFF",
    "tabInactiveBg": "#0A0E22",
    "tabInactiveFg": "#737DB5",
    "statuslineBg": "#151B36",
    "statuslineFg": "#E8ECFF",
    "border": "#4E568A",
    "borderFocused": "#66F0FF",
    "panelBg": "#121733"
  },
  "atmosphere": {
    "window": {
      "opacity": 0.94,
      "unfocusedOpacity": 0.86,
      "blur": true,
      "blurRadius": 20,
      "useMica": false,
      "padding": { "x": 18, "y": 14 }
    },
    "wallpaper": {
      "path": "assets/wallpaper.png",
      "opacity": 0.40,
      "unfocusedOpacity": 0.24,
      "alignment": "bottom-right",
      "fit": "cover",
      "codeSafeZone": { "side": "left", "startX": 0.0, "endX": 0.54 }
    },
    "shader": {
      "glsl": "shaders/live.glsl",
      "hlsl": "shaders/live.hlsl",
      "defaultProfile": "balanced",
      "params": {
        "meteorCycleSec": 6.0,
        "crtPulseHz": 2.1,
        "narrowFadeAspect": 1.15
      }
    }
  },
  "typography": {
    "style": "8bit",
    "families": ["departure-mono-nf", "fusion-pixel-12-zh", "jetbrains-mono-nf"],
    "sizePt": 11.0,
    "lineHeight": 1.28,
    "weight": "normal",
    "ligatures": false
  },
  "overrides": {
    "terminal": {
      "cursorShape": "block",
      "cursorBlink": false,
      "macosTitlebarStyle": "transparent"
    },
    "prompt": {
      "preset": "pixel-frame",
      "badgeText": "★",
      "okLabel": "♥",
      "errorLabel": "[ERR]",
      "promptSymbol": "▶",
      "consoleTitlePrefix": "★ STARLIGHT",
      "segmentColors": {
        "badgeBg": "#66F0FF",
        "badgeFg": "#0A0F25",
        "pathBg": "#66F0FF",
        "pathFg": "#0A0F25",
        "gitBg": "#191E3C",
        "gitFg": "#D2B8FF"
      }
    },
    "fzf": {
      "border": "sharp",
      "prompt": "▶ ",
      "pointer": "♥",
      "marker": "★"
    },
    "fastfetch": {
      "logoPath": "assets/logo.txt",
      "headerTitle": "★ STARLIGHT // 8-BIT TERM",
      "fieldLabels": {
        "title": "♥ USER",
        "os": "◈ OS",
        "shell": "▶ SHELL",
        "terminal": "▣ TERM",
        "cpu": "✦ CPU",
        "memory": "✦ RAM",
        "uptime": "✦ UP"
      }
    }
  }
}
